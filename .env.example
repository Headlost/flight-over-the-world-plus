# Deployment/developer configuration, never entered by players.
# Local development: ignored .env.local. VITE values are included in browser code.
# Direct-auth development only: a public read-only token (never a private-scope token).
VITE_CESIUM_ION_KEY=
# Optional comma-separated public read-only tokens, in replacement order.
# Used only after an ion 401 authentication error; never to bypass quotas.
VITE_CESIUM_ION_FALLBACK_KEYS=
# Optional Photon-compatible search endpoint.
VITE_GEOCODING_URL=

# Provider-approved terrain session broker. Only admission and renewal use it;
# terrain tiles are downloaded directly from Google.
# When enabled in production, leave both browser ion token variables empty.
VITE_TERRAIN_POOL_ENDPOINT=
